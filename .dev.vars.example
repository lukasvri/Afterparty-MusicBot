# Local Workers variables. Configure equivalent secrets in production.
ADMIN_BRIDGE_KEY=
GUTTA_CORE_PUBLIC_URL=https://core.example.com
GUTTA_CORE_SITE_ORIGIN=https://afterparty.example.com
YOUTUBE_API_KEY=
# Optional owner-password fallback. Store a PBKDF2 hash, never a plaintext password.
ADMIN_PASSWORD_HASH=
# Optional private HTTPS updater link, shown only during owner-password sessions.
OWNER_UPDATE_URL=
# Optional isolated Discord Activity test mode. Off unless explicitly enabled.
DISCORD_ACTIVITY_ENABLED=false
DISCORD_ACTIVITY_CLIENT_ID=
# Optional root launch document on a dedicated Activity test website only.
DISCORD_ACTIVITY_LAUNCH_ROOT=false
