{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/**/{page,layout,route}.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "build/*.ts",
        "operations/update-panel/*.{js,mjs}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "hooks/**/*.ts",
        "lib/**/*.ts",
        "db/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "build/*.ts",
        "operations/update-panel/*.{js,mjs}",
        "app/**/*.css"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{svelte,ts}",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ],
      "project": [
        "src/**/*.{svelte,ts}",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "services/core": {
      "entry": [
        "src/migrate.ts",
        "tests/**/*.ts",
        "benchmarks/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "benchmarks/**/*.ts"
      ]
    }
  }
}
