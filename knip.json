{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "lib/api/**/route.ts",
        "scripts/**/*.{ts,mjs}",
        "operations/update-panel/*.{js,mjs}"
      ],
      "project": [
        "lib/**/*.ts",
        "db/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "operations/update-panel/*.{js,mjs}"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{svelte,ts}",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ],
      "project": [
        "src/**/*.{svelte,ts}",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "services/core": {
      "entry": [
        "src/migrate.ts",
        "tests/**/*.ts",
        "benchmarks/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "benchmarks/**/*.ts"
      ]
    }
  }
}
