# Required. Never commit the completed .env file.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
PUBLIC_SITE_URL=https://afterparty.example.com
PUBLIC_SITE_ADMIN_KEY=
# Discord OAuth for the website admin.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional opt-in Core authority. Requires authenticated website GUTTA_CORE_PUBLIC_URL.
# CORE_BRIDGE_PRESENCE=authority
# Leave unset for legacy five-second D1 presence. Read docs/D1_WRITE_BUDGET.md first.
# Optional services and channel selection.
MUSIC_TEXT_CHANNEL_ID=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Deezer metadata-to-existing-source matching, default off. No Deezer audio streaming.
DEEZER_METADATA=0
# Optional, default-off approved short-preview pilot. Configure rights and inventory locally first.
# Separate from DEEZER_METADATA; snapshot expires within five minutes, no automatic refresh.
GUESS_DEEZER_PREVIEWS=0
GUESS_DEEZER_INVENTORY_PATH=
# Alpha builds prepare the bundled quiz automatically through yt-dlp and FFmpeg.
# auto/unset uses the alpha default; 0 explicitly disables it. Stable/beta/rc stay off.
# Snapshot lasts at most 30 minutes or earlier recording expiry; no automatic refresh.
GUESS_YOUTUBE_CLIPS=auto
# Alpha defaults to edm-festival-hits when both selectors below are empty.
# Choose either a bundled pack or a custom private inventory path, never both.
GUESS_YOUTUBE_PACK=
GUESS_YOUTUBE_INVENTORY_PATH=
LASTFM_API_KEY=
MAX_ACTIVE_VOICE_SESSIONS=8
