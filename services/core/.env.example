# Required. Never commit the completed .env file.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
PUBLIC_SITE_URL=https://afterparty.example.com
PUBLIC_SITE_ADMIN_KEY=
# Discord OAuth for the website admin.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional services and channel selection.
MUSIC_TEXT_CHANNEL_ID=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
MAX_ACTIVE_VOICE_SESSIONS=8
# Optional Activity test mode; use the same application as this isolated test bot.
DISCORD_ACTIVITY_ENABLED=false
DISCORD_ACTIVITY_CLIENT_ID=
# Comma-separated exact test guild IDs, at most 20. Empty means disabled.
DISCORD_ACTIVITY_TEST_GUILD_IDS=
