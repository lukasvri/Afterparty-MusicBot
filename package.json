{
  "name": "site-creator-vinext-starter",
  "version": "2.4.0-alpha.8",
  "private": true,
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.ts",
    "dev": "node scripts/run-framework.ts dev",
    "build": "node scripts/run-framework.ts build",
    "start": "node --import ./scripts/sites-env.ts ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "test:fullscreen": "node scripts/fullscreen.test.ts",
    "setup:cloud": "bash scripts/cloud.sh setup",
    "check:all": "bash scripts/cloud.sh check",
    "project": "node scripts/project.ts",
    "release:check": "node scripts/releases.ts --check",
    "release:notes": "node scripts/releases.ts --notes",
    "release:changelog": "node scripts/releases.ts --write",
    "test:party": "node scripts/party.browser.ts",
    "test:sync": "node --test --test-concurrency=1 --test-timeout=45000 scripts/sync.browser.ts",
    "test:unit": "node --test scripts/fullscreen.test.ts scripts/audio-preferences.test.ts scripts/playback-sync.test.ts scripts/live-clock.test.ts scripts/live-command.test.ts scripts/native-seek.test.ts scripts/rooms.test.ts scripts/bridge.test.ts scripts/admin-auth.test.ts scripts/hosting-output.test.ts scripts/afterparty-compatibility.test.ts scripts/releases.test.ts scripts/radio-catalog-probe.test.ts scripts/queue-order.test.ts scripts/player-readiness.test.ts scripts/guess-authority.test.ts scripts/guess-worker.test.ts scripts/social-authority.test.ts scripts/guess-availability.test.ts",
    "test:admin-channels": "node scripts/admin-channels.browser.ts",
    "test:guess": "node --test --test-concurrency=1 --test-timeout=90000 scripts/guess.browser.ts scripts/guess-synthetic.browser.ts",
    "test:copyright": "node scripts/copyright.browser.ts",
    "test:social": "node scripts/social.browser.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "license": "MIT"
}
