{
  "name": "afterparty",
  "version": "3.0.0-alpha.1",
  "private": true,
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.ts",
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm run build",
    "test:web": "npm --prefix apps/web test",
    "build": "node scripts/build-website.ts",
    "start": "node --import ./apps/web/scripts/runtime.ts ./apps/web/node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "test:fullscreen": "node scripts/fullscreen.test.ts",
    "setup:cloud": "bash scripts/cloud.sh setup",
    "check:all": "bash scripts/cloud.sh check",
    "project": "node scripts/project.ts",
    "release:check": "node scripts/releases.ts --check",
    "release:notes": "node scripts/releases.ts --notes",
    "release:changelog": "node scripts/releases.ts --write",
    "test:unit": "node --test scripts/error-reporting.test.ts scripts/fullscreen.test.ts scripts/audio-preferences.test.ts scripts/playback-sync.test.ts scripts/live-clock.test.ts scripts/live-command.test.ts scripts/rooms.test.ts scripts/bridge.test.ts scripts/admin-auth.test.ts scripts/hosting-output.test.ts scripts/afterparty-compatibility.test.ts scripts/releases.test.ts scripts/radio-catalog-probe.test.ts scripts/guess-authority.test.ts scripts/guess-worker.test.ts scripts/social-authority.test.ts scripts/guess-availability.test.ts scripts/toolchain.test.mjs scripts/playlist-import-worker.test.ts scripts/cloudflare-config.test.ts scripts/hosting-transition.test.ts operations/update-panel/test_model.mjs",
    "build:cloudflare": "node scripts/cloudflare.ts build",
    "deploy:cloudflare": "node scripts/cloudflare.ts deploy",
    "verify:cloudflare": "node scripts/cloudflare.ts verify",
    "audit:unused": "npm --prefix apps/web run sync && node --import ./apps/web/scripts/runtime.ts node_modules/knip/bin/knip.js --include files --no-progress",
    "test:browser": "npm --prefix apps/web run test:browser",
    "test:stack": "npm --prefix apps/web run test:stack",
    "coverage:unit": "node scripts/coverage.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "qrcode": "^1.5.4",
    "@sentry/browser": "11.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "knip": "6.43.0",
    "miniflare": "5.20260730.0-alpha",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "ws": "8.22.0",
    "zod": "3.25.76",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "esbuild": "0.28.2",
    "undici": "7.30.1",
    "ws": "8.22.0",
    "fast-uri": "3.1.8",
    "fflate": "0.7.5",
    "image-size": "2.0.3"
  },
  "license": "MIT"
}
